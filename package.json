{
  "name": "healthy-habits-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Progressive Web App for habit tracking (vanilla-first).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:pages": "BUILD_TARGET=pages vite build",
    "build:local": "BUILD_TARGET=local vite build",
    "preview:local": "npm run build:local && node scripts/preview.mjs",
    "preview:phone": "npm run build:local && node scripts/preview.mjs --phone",
    "preview:pages": "npm run build:pages && node scripts/preview-pages.mjs",
    "deploy": "npm run build:pages && gh-pages -d dist",
    "test": "npm run test:unit && npm run test:migration",
    "test:unit": "vitest run tests/unit tests/convex",
    "test:migration": "vitest run tests/migration",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.js",
    "test:convex": "tsc -p convex/tsconfig.json --noEmit",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .js",
    "analyze": "BUILD_TARGET=local vite build --mode analyze",
    "check:bundle": "npm run build:local && node scripts/check-bundle-budgets.mjs",
    "check:bundle:pages": "npm run build:pages && node scripts/check-bundle-budgets.mjs",
    "clean": "rm -rf dist node_modules/.vite",
    "audit": "npm audit && npm run lint && npm run build:local"
  },
  "dependencies": {
    "@clerk/clerk-js": "^6.25.8",
    "convex": "^1.42.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "autoprefixer": "^10.4.21",
    "convex-test": "^0.0.54",
    "eslint": "^8.57.1",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "keywords": [
    "pwa",
    "habits",
    "tracker",
    "health",
    "productivity",
    "javascript",
    "vite"
  ],
  "author": "Healthy Habits Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/healthy-habits-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/healthy-habits-tracker/issues"
  },
  "homepage": "https://github.com/your-org/healthy-habits-tracker#readme"
}

{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/main.js",
    "src/styles/*.css",
    "playwright*.config.js",
    "vitest.config.js",
    "scripts/*.mjs",
    "convex/**/*.ts",
    "tests/**/*.test.js",
    "tests/e2e/**/*.spec.js",
    "tests/pwa/**/*.spec.js"
  ],
  "project": [
    "src/**/*.{js,css}",
    "scripts/*.mjs",
    "convex/**/*.ts",
    "*.config.js"
  ],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "convex/_generated/**"
  ],
  "playwright": false,
  "vite": false
}

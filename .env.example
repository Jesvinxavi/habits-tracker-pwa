# Public browser configuration. Never place Clerk secret keys or Convex deploy
# keys in VITE_* variables.
#
# This file describes a *local* setup, which must point at the development
# Convex deployment. The deployed app's values live in GitHub repository
# variables and point at the production deployment instead; see
# docs/operations/CONVEX_ENVIRONMENT_SEPARATION_BRIEF.md.
CONVEX_DEPLOYMENT=dev:your-dev-deployment
VITE_CONVEX_URL=https://your-dev-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Convex dashboard environment variable used by convex/auth.config.ts. It must
# be set on both the dev and the production deployment:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-instance.clerk.accounts.dev --prod
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
